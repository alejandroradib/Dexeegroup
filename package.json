    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "rls:test": "tsx scripts/rls-test.ts",
    "promote-admin": "tsx scripts/promote-admin.ts",
    "prepare": "husky",
    "demo:db": "bash scripts/demo/setup-db.sh",
    "demo": "tsx scripts/demo/start.ts"
  },
  "dependencies": {
