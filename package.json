    "next-intl": "^4.8.0",
    "next-mdx-remote": "^6.0.0",
    "openai": "^7.17.0",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "resend": "^6.28.1",
