  "items": [
    { "id": "ipip-01", "factor": "extraversion", "reverse": false, "text_en": "Am the life of the party.", "text_es": "Soy el alma de la fiesta." },
    { "id": "ipip-02", "factor": "agreeableness", "reverse": true, "text_en": "Feel little concern for others.", "text_es": "Me preocupo poco por los demás." },
    { "id": "ipip-03", "factor": "conscientiousness", "reverse": false, "text_en": "Am always prepared.", "text_es": "Siempre estoy bien preparado/a." },
    { "id": "ipip-04", "factor": "emotional_stability", "reverse": true, "text_en": "Get stressed out easily.", "text_es": "Me estreso con facilidad." },
    { "id": "ipip-05", "factor": "intellect", "reverse": false, "text_en": "Have a rich vocabulary.", "text_es": "Tengo un vocabulario amplio." },
    { "id": "ipip-06", "factor": "extraversion", "reverse": true, "text_en": "Don't talk a lot.", "text_es": "No hablo mucho." },
    { "id": "ipip-07", "factor": "agreeableness", "reverse": false, "text_en": "Am interested in people.", "text_es": "Me interesan las personas." },
    { "id": "ipip-08", "factor": "conscientiousness", "reverse": true, "text_en": "Leave my belongings around.", "text_es": "Dejo mis cosas tiradas por ahí." },
    { "id": "ipip-09", "factor": "emotional_stability", "reverse": false, "text_en": "Am relaxed most of the time.", "text_es": "Estoy relajado/a la mayor parte del tiempo." },
    { "id": "ipip-10", "factor": "intellect", "reverse": true, "text_en": "Have difficulty understanding abstract ideas.", "text_es": "Me cuesta entender las ideas abstractas." },
    { "id": "ipip-11", "factor": "extraversion", "reverse": false, "text_en": "Feel comfortable around people.", "text_es": "Me siento cómodo/a rodeado/a de gente." },
    { "id": "ipip-12", "factor": "agreeableness", "reverse": true, "text_en": "Insult people.", "text_es": "Insulto a las personas." },
    { "id": "ipip-13", "factor": "conscientiousness", "reverse": false, "text_en": "Pay attention to details.", "text_es": "Presto atención a los detalles." },
    { "id": "ipip-14", "factor": "emotional_stability", "reverse": true, "text_en": "Worry about things.", "text_es": "Me preocupo por las cosas." },
    { "id": "ipip-15", "factor": "intellect", "reverse": false, "text_en": "Have a vivid imagination.", "text_es": "Tengo una imaginación muy viva." },
    { "id": "ipip-16", "factor": "extraversion", "reverse": true, "text_en": "Keep in the background.", "text_es": "Me mantengo en un segundo plano." },
    { "id": "ipip-17", "factor": "agreeableness", "reverse": false, "text_en": "Sympathize with others' feelings.", "text_es": "Me compadezco de los sentimientos de los demás." },
    { "id": "ipip-18", "factor": "conscientiousness", "reverse": true, "text_en": "Make a mess of things.", "text_es": "Hago un desorden de las cosas." },
    { "id": "ipip-19", "factor": "emotional_stability", "reverse": false, "text_en": "Seldom feel blue.", "text_es": "Rara vez me siento triste." },
    { "id": "ipip-20", "factor": "intellect", "reverse": true, "text_en": "Am not interested in abstract ideas.", "text_es": "No me interesan las ideas abstractas." },
    { "id": "ipip-21", "factor": "extraversion", "reverse": false, "text_en": "Start conversations.", "text_es": "Inicio conversaciones." },
    { "id": "ipip-22", "factor": "agreeableness", "reverse": true, "text_en": "Am not interested in other people's problems.", "text_es": "No me interesan los problemas de los demás." },
    { "id": "ipip-23", "factor": "conscientiousness", "reverse": false, "text_en": "Get chores done right away.", "text_es": "Hago las tareas pendientes de inmediato." },
    { "id": "ipip-24", "factor": "emotional_stability", "reverse": true, "text_en": "Am easily disturbed.", "text_es": "Me perturbo con facilidad." },
    { "id": "ipip-25", "factor": "intellect", "reverse": false, "text_en": "Have excellent ideas.", "text_es": "Tengo ideas excelentes." },
    { "id": "ipip-26", "factor": "extraversion", "reverse": true, "text_en": "Have little to say.", "text_es": "Tengo poco que decir." },
    { "id": "ipip-27", "factor": "agreeableness", "reverse": false, "text_en": "Have a soft heart.", "text_es": "Tengo un corazón blando." },
    { "id": "ipip-28", "factor": "conscientiousness", "reverse": true, "text_en": "Often forget to put things back in their proper place.", "text_es": "A menudo olvido volver a poner las cosas en su lugar." },
    { "id": "ipip-29", "factor": "emotional_stability", "reverse": true, "text_en": "Get upset easily.", "text_es": "Me molesto con facilidad." },
    { "id": "ipip-30", "factor": "intellect", "reverse": true, "text_en": "Do not have a good imagination.", "text_es": "No tengo buena imaginación." },
    { "id": "ipip-31", "factor": "extraversion", "reverse": false, "text_en": "Talk to a lot of different people at parties.", "text_es": "Hablo con muchas personas distintas en las fiestas." },
    { "id": "ipip-32", "factor": "agreeableness", "reverse": true, "text_en": "Am not really interested in others.", "text_es": "En realidad no me interesan los demás." },
    { "id": "ipip-33", "factor": "conscientiousness", "reverse": false, "text_en": "Like order.", "text_es": "Me gusta el orden." },
    { "id": "ipip-34", "factor": "emotional_stability", "reverse": true, "text_en": "Change my mood a lot.", "text_es": "Cambio mucho de estado de ánimo." },
    { "id": "ipip-35", "factor": "intellect", "reverse": false, "text_en": "Am quick to understand things.", "text_es": "Entiendo las cosas rápidamente." },
    { "id": "ipip-36", "factor": "extraversion", "reverse": true, "text_en": "Don't like to draw attention to myself.", "text_es": "No me gusta llamar la atención." },
    { "id": "ipip-37", "factor": "agreeableness", "reverse": false, "text_en": "Take time out for others.", "text_es": "Dedico tiempo a los demás." },
    { "id": "ipip-38", "factor": "conscientiousness", "reverse": true, "text_en": "Shirk my duties.", "text_es": "Evado mis responsabilidades." },
    { "id": "ipip-39", "factor": "emotional_stability", "reverse": true, "text_en": "Have frequent mood swings.", "text_es": "Tengo cambios de humor frecuentes." },
    { "id": "ipip-40", "factor": "intellect", "reverse": false, "text_en": "Use difficult words.", "text_es": "Uso palabras complejas." },
    { "id": "ipip-41", "factor": "extraversion", "reverse": false, "text_en": "Don't mind being the center of attention.", "text_es": "No me molesta ser el centro de atención." },
    { "id": "ipip-42", "factor": "agreeableness", "reverse": false, "text_en": "Feel others' emotions.", "text_es": "Siento las emociones de los demás." },
    { "id": "ipip-43", "factor": "conscientiousness", "reverse": false, "text_en": "Follow a schedule.", "text_es": "Sigo un horario." },
    { "id": "ipip-44", "factor": "emotional_stability", "reverse": true, "text_en": "Get irritated easily.", "text_es": "Me irrito con facilidad." },
    { "id": "ipip-45", "factor": "intellect", "reverse": false, "text_en": "Spend time reflecting on things.", "text_es": "Dedico tiempo a reflexionar sobre las cosas." },
    { "id": "ipip-46", "factor": "extraversion", "reverse": true, "text_en": "Am quiet around strangers.", "text_es": "Soy callado/a con personas desconocidas." },
    { "id": "ipip-47", "factor": "agreeableness", "reverse": false, "text_en": "Make people feel at ease.", "text_es": "Hago que las personas se sientan a gusto." },
    { "id": "ipip-48", "factor": "conscientiousness", "reverse": false, "text_en": "Am exacting in my work.", "text_es": "Soy exigente en mi trabajo." },
    { "id": "ipip-49", "factor": "emotional_stability", "reverse": true, "text_en": "Often feel blue.", "text_es": "A menudo me siento triste." },
    { "id": "ipip-50", "factor": "intellect", "reverse": false, "text_en": "Am full of ideas.", "text_es": "Estoy lleno/a de ideas." }
  ]
