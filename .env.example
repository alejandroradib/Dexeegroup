# Public URL of the site, without trailing slash (used for metadata, sitemap and emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anon (publishable) key; the only key the browser ever holds
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase service-role key; server only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string; used only by scripts (seed, rls-test)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Anthropic API key for job drafting and assessment grading
ANTHROPIC_API_KEY=
# Anthropic model id (confirm in the Anthropic docs at build time)
ANTHROPIC_MODEL=claude-sonnet-5
# OpenAI API key, used only for Whisper transcription
OPENAI_API_KEY=
# Resend API key for transactional email
RESEND_API_KEY=
# From address for all emails
EMAIL_FROM=Dexee <no-reply@dexeegroup.com>
# Shared secret that protects /api/cron/* route handlers. At least 32 random characters,
# generated with `openssl rand -hex 32`; placeholders such as change-me are rejected at startup.
CRON_SECRET=
# Upstash Redis REST URL for rate limiting (in-memory fallback when empty)
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=
# Sentry DSN; error reporting is disabled when empty
SENTRY_DSN=
# Analytics provider: none | plausible | ga4
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Analytics site id (Plausible domain or GA4 measurement id)
NEXT_PUBLIC_ANALYTICS_ID=
# Calendly booking URL used by "Book a call" buttons
CALENDLY_URL=
# Email of the first admin (used by npm run promote-admin without --email)
ADMIN_EMAIL=info@dexeegroup.com
# Google Indexing API service-account JSON, as one line. Unset, job publish and close skip the ping.
INDEXING_API_CREDENTIALS=
# Password for the demo accounts created by scripts/seed-demo.ts; required by the script, never committed
DEMO_SEED_PASSWORD=
# Directory that holds the assessment banks with their answer keys; never committed (see docs/RUNBOOK.md)
ASSESSMENT_BANKS_DIR=
